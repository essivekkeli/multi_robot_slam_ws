{
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 0.0,
    "imu_frame_id": "robot1/lidar",
    "lidar_frame_id": "robot1/lidar",
    "base_frame_id": "robot1/base_footprint",
    "odom_frame_id": "robot1/odom",
    "map_frame_id": "robot1/map",
    "publish_imu2lidar": false,
    "tf_time_offset": 1e-06,
    "extension_modules": [
      "libstandard_viewer.so",
      "librviz_viewer.so"
    ],
    "imu_topic": "/robot1/imu",
    "points_topic": "/robot1/points/points",
    "image_topic": "/image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data"
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}